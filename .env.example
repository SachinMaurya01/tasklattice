APP_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/tasklattice?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
SHUTDOWN_TIMEOUT=10s
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_MIN=100
IDEMPOTENCY_TTL=24h

REDIS_URL=redis://localhost:6379/0

AWS_REGION=us-east-1
# Local SQS (ElasticMQ/LocalStack) override; empty for real AWS.
AWS_ENDPOINT_URL=
SQS_QUEUE_URL=
SQS_DLQ_URL=
WORKER_OUTBOX_BATCH=50
WORKER_POLL_INTERVAL=2s
SQS_VISIBILITY_TIMEOUT=30
SQS_MAX_RECEIVE_COUNT=5
